{
    "name": "@pdm/server",
    "private": true,
    "type": "module",
    "scripts": {
        "tunnel": "node --env-file .env tunnel.mjs",
        "dev": "concurrently --kill-others \"pnpm tunnel\" \"pnpm dev:server\" \"pnpm pgtyped\"",
        "dev:server": "wait-on tcp:127.0.0.1:5432 && tsx --env-file .env --watch src/index.ts",
        "pgtyped": "wait-on tcp:127.0.0.1:5432 && node --env-file .env -e \"require('child_process').spawn('pgtyped', ['-w','-c','pgtyped.config.json'], { stdio: 'inherit', shell: true })\"",
        "start": "tsx --env-file .env src/index.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@ai-sdk/openai": "^2.0.44",
        "@pdm/contracts": "workspace:*",
        "@pgtyped/runtime": "^2.4.2",
        "@types/jsonwebtoken": "^9.0.10",
        "ai": "^5.0.60",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.16.3",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@pgtyped/cli": "^2.4.3",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/pg": "^8.15.5",
        "concurrently": "^9.0.0",
        "tsx": "^4.16.0",
        "wait-on": "^9.0.1"
    }
}
