{
    "$schema": "https://biomejs.dev/schemas/2.2.3/schema.json",
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "includes": ["**/*.ts", "**/*.tsx", "**/*.html", "!**/*.queries.ts"]
    },
    "linter": {
        "enabled": true,
        "includes": ["**/*.ts", "!**/*.queries.ts"]
    },
    "javascript": {
        "formatter": {
            "lineWidth": 100
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
